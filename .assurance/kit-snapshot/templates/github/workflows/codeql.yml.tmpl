# What this is: CodeQL — GitHub's automatic security scanner. It reads the
# code on every push (and weekly) and reports vulnerable patterns under the
# repository's Security tab. Free on public repositories.
# Safe to edit: yes — shipshape will ask before overwriting your edits.
# managed-by: shipshape v{{KIT_VERSION}}
name: CodeQL

on:
  push:
    branches: ["{{DEFAULT_BRANCH}}"]
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
  schedule:
    - cron: "17 6 * * 1"

# Least privilege at the top; the job escalates only what scanning needs.
permissions:
  contents: read

jobs:
  analyze:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@v7
      - uses: github/codeql-action/init@v4
        with:
          languages: "{{CODEQL_LANGUAGE}}"
      - uses: github/codeql-action/autobuild@v4
      - uses: github/codeql-action/analyze@v4
