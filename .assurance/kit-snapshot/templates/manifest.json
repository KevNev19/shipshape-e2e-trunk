      "overwrite_policy": "ask-if-drifted"
    },
    {
      "src": "github/workflows/ci-node-yarn-modern.yml.tmpl",
      "dest": ".github/workflows/ci.yml",
      "when": { "primary_language": "node", "node_package_manager": "yarn_modern" },
      "pillar": "workflows",
      "overwrite_policy": "ask-if-drifted"
    },
