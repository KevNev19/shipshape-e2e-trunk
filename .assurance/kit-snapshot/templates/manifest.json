{
  "comment": "Single source of truth for what shipshape writes into a target repo. Each entry: src (template under templates/), dest (path in target repo), optional when (all conditions must hold), optional feature_flag (config.features gate), optional remove_when_inapplicable for safety-critical revocation, pillar, overwrite_policy (ask-if-drifted | write-once).",
  "templates": [
    {
      "src": "harness/sdlc-harness.md.tmpl",
      "dest": "docs/sdlc/harness.md",
      "pillar": "process",
      "overwrite_policy": "ask-if-drifted"
    },
    {
      "src": "adapters/CLAUDE.md.tmpl",
      "dest": "CLAUDE.md",
      "pillar": "process",
      "overwrite_policy": "ask-if-drifted"
    },
    {
      "src": "adapters/AGENTS.md.tmpl",
      "dest": "AGENTS.md",
      "pillar": "process",
      "overwrite_policy": "ask-if-drifted"
    },
    {
      "src": "docs/design-doc.md.tmpl",
      "dest": "docs/sdlc/design.md",
      "pillar": "onboarding",
      "overwrite_policy": "write-once"
    },
    {
      "src": "docs/change-intent.md.tmpl",
      "dest": ".sdlc/templates/change-intent.md",
      "pillar": "process",
      "overwrite_policy": "ask-if-drifted"
    },
    {
      "src": "github/workflows/ci-python.yml.tmpl",
      "dest": ".github/workflows/ci.yml",
      "when": { "primary_language": "python" },
      "pillar": "workflows",
      "overwrite_policy": "ask-if-drifted"
    },
    {
